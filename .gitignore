# 密钥，绝不提交
.env
keys.txt
*.key
*.pem
secrets.*

# 虚拟环境与依赖
.venv/
vendor/

# 打包产物
dist/

# 原始资料（2MB PDF，只是术语表的来源，运行用不上）
data/raw/

# 本机数据：设置（含密钥）、自定义预设、当前选中
data/settings.json
data/user_presets.json
data/presets_state.json

# 本地验证产物
.tmp/
logs/
__pycache__/
*.pyc

# 安装包
.setup/*.exe
.setup/*.nupkg
.setup/*.log

# 系统文件
Thumbs.db
.DS_Store
