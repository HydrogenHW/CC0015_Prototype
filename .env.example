# 复制为 .env 后填入。.env 不要提交到版本库。
# 更推荐用环境变量（见 README），这样项目文件夹里一个密钥都没有。

# ---- 密钥 ----
# 火山引擎豆包语音 API Key（识别用）
# 控制台：https://console.volcengine.com/speech/new/setting/apikeys
VOLC_API_KEY=

# OpenAI（翻译用）：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# DeepSeek（右侧术语助手用）：https://platform.deepseek.com/api_keys
# 不填也能用，只是右侧对话框会提示未配置
DEEPSEEK_API_KEY=

# Deepgram（可选，只有切到 ASR_PROVIDER=deepgram 时才需要）
# DEEPGRAM_API_KEY=

# ---- 识别引擎 ----
# volc     = 火山豆包流式（默认，真流式、噪声下更稳）
# openai   = OpenAI Realtime 转写（说完才出字）
# deepgram = Deepgram 流式
# ASR_PROVIDER=volc

# 火山 2.0 用 volc.seedasr.sauc.duration，1.0 用 volc.bigasr.sauc.duration
# 用错会直接 403
# VOLC_RESOURCE_ID=volc.seedasr.sauc.duration

# OpenAI 转写模型（仅 openai 引擎用）
# OPENAI_ASR_MODEL=gpt-4o-transcribe

# Deepgram 模型（仅 deepgram 引擎用）
# ASR_MODEL=nova-2

# 静音多久判定一句结束（毫秒）。火山推荐 800~1000，太小会切碎句子。
# ASR_ENDPOINTING=800

# 术语偏置：把术语表里的中医词作为热词喂给识别引擎。
# 火山（corpus.hotwords）和 Deepgram（keywords）都支持，OpenAI 不支持。
# ASR_KEYWORDS=1

# ---- 处理 ----
# 同音纠错：识别把术语听成同音字时，按拼音改回来（本地完成，无延迟）
# PINYIN_FIX=1

# 翻译模型（可选，默认 gpt-4o-mini）
# TRANSLATE_MODEL=gpt-4o-mini

# 翻译超时（秒）
# TRANSLATE_TIMEOUT=6

# 并发翻译路数
# TRANSLATE_CONCURRENCY=3

# 没有密钥时打开这个，用假数据跑通界面和音频链路
# MOCK=1
