# 复制为 .env 后填入。.env 不要提交到版本库。
# 更推荐用环境变量（见 README），这样项目文件夹里一个密钥都没有。

# ---- 密钥 ----
# OpenAI（识别和翻译都用它）：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Deepgram（可选，只有切到 ASR_PROVIDER=deepgram 时才需要）
# 注册即送 200 美元额度，不需要信用卡：https://console.deepgram.com
DEEPGRAM_API_KEY=

# ---- 识别引擎 ----
# openai = OpenAI Realtime 转写（默认，只需要一个 key）
# deepgram = Deepgram 流式识别（需要额外的 key）
# ASR_PROVIDER=openai

# OpenAI 转写模型：gpt-4o-transcribe（准）或 gpt-4o-mini-transcribe（快、省）
# OPENAI_ASR_MODEL=gpt-4o-transcribe

# Deepgram 模型（仅 deepgram 引擎用）
# ASR_MODEL=nova-2

# 静音多久判定一句结束（毫秒）。识别断断续续就调大，出字慢就调小。
# ASR_ENDPOINTING=500

# 术语偏置：把术语表里的中医词喂给识别引擎（仅 deepgram 引擎支持）。
# ASR_KEYWORDS=1

# ---- 处理 ----
# 同音纠错：识别把术语听成同音字时，按拼音改回来（本地完成，无延迟）
# PINYIN_FIX=1

# 翻译模型（可选，默认 gpt-4o-mini）
# TRANSLATE_MODEL=gpt-4o-mini

# 并发翻译路数
# TRANSLATE_CONCURRENCY=3

# 没有密钥时打开这个，用假数据跑通界面和音频链路
# MOCK=1
