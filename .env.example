# 复制为 .env 后填入。.env 不要提交到版本库。

# Deepgram：https://console.deepgram.com
# 注册即送 200 美元额度，不需要信用卡
DEEPGRAM_API_KEY=

# OpenAI：https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 识别模型（可选，默认 nova-2）
# ASR_MODEL=nova-2

# 同音纠错：识别把术语听成同音字时，按拼音改回来（本地完成，无延迟）
# PINYIN_FIX=1

# 静音多久判定一句结束（毫秒）。识别断断续续就调大，出字慢就调小。
# ASR_ENDPOINTING=300

# 术语偏置：把术语表里的中医词喂给识别引擎，提高领域词命中率。
# 效果因引擎而异，建议开着跑一遍、关着跑一遍做对比。
# ASR_KEYWORDS=1

# 翻译模型（可选，默认 gpt-4o-mini）
# TRANSLATE_MODEL=gpt-4o-mini

# 没有密钥时打开这个，用假数据跑通界面和音频链路
# MOCK=1
