{
  "manifest_version": 3,
  "name": "中医课堂实时字幕",
  "version": "1.0.0",
  "description": "一键打开本地运行的中医课堂实时双语字幕。",
  "action": {
    "default_title": "打开字幕",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:8000/*"]
}
